.DS_Store

# Third-party research clones (628M). Reproduce with scripts/clone-research-repos.sh.
# Anchor this rule so the tracked evidence corpus under notes/repos/ remains visible.
/repos/
reviews_triage/

# Durable local automation, probe, and verification output. Every run gets a
# unique subdirectory so reports remain inspectable without polluting Git.
/artifacts/

# Python bytecode generated by repository tooling and tests.
__pycache__/

# SwiftPM build products (were accidentally committed by PR #3; untracked since)
probes/.build/
probes/DeviceProbes.xcodeproj/
probes/DeviceProbeAssets/*
!probes/DeviceProbeAssets/README.md

# Generated build products and GitHub Pages output.
/.build/
